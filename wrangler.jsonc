{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms-storage",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "datareport-iasa-storage"
    }
  ],
  "vars": {
    "MS_AUTH_URL": "https://ms-auth.agro-ecologica.workers.dev"
  }
}
